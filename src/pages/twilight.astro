---
const stars = Array.from({ length: 34 }, (_, i) => {
  const random = (salt: number) => {
    const n = Math.sin(i * 127.1 + salt * 311.7) * 43758.5453;
    return n - Math.floor(n);
  };
  return { x: 4 + random(1) * 92, y: 7 + random(2) * 42,
    size: .7 + random(3) * .8, opacity: .12 + random(4) * .28 };
});
// Overlap the shoreline at y=785 to prevent subpixel gaps between the two fills.
const mountainPath = `M 330 787 Q 380 784 414 775
  C 443 763 469 751 495 741 L 517 729
  C 548 714 575 687 605 663 L 635 639
  Q 652 626 663 610 L 669 607 L 674 610 L 683 608
  L 691 610 L 699 607 L 704 609 L 709 605
  C 735 635 762 666 790 692
  C 821 721 850 742 880 755 L 904 765
  Q 922 770 935 781 L 935 787 Z`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Twilight blue hour." />
    <title>imasepan — twilight</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body>
    <main aria-label="Twilight">
      <div class="landscape" aria-hidden="true">
        <canvas class="atmosphere"></canvas>
        <div class="sky-haze"></div>
        <div class="stars">
          {stars.map(star => <i style={`left:${star.x}%;top:${star.y}%;width:${star.size}px;height:${star.size}px;opacity:${star.opacity}`}></i>)}
        </div>
        <svg class="terrain" viewBox="0 0 1000 1000" preserveAspectRatio="none" focusable="false">
          <defs>
            <path id="spark-arc" d="M 235 789 C 235 650 280 410 435 235" pathLength="1" />
            <filter id="spark-blur" x="-100%" y="-20%" width="300%" height="140%">
              <feGaussianBlur stdDeviation="2.4" />
            </filter>
            <radialGradient id="spark-glow">
              <stop stop-color="#bcffff" stop-opacity=".8" />
              <stop offset=".3" stop-color="#63efff" stop-opacity=".3" />
              <stop offset="1" stop-color="#41dcff" stop-opacity="0" />
            </radialGradient>
            <filter id="spark-flare-blur" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="1.1" />
            </filter>
            <linearGradient id="spark-flare-horizontal">
              <stop stop-color="white" stop-opacity="0" />
              <stop offset=".5" stop-color="white" stop-opacity=".9" />
              <stop offset="1" stop-color="white" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="spark-flare-vertical" x1="0" y1="0" x2="0" y2="1">
              <stop stop-color="white" stop-opacity="0" />
              <stop offset=".5" stop-color="white" stop-opacity=".9" />
              <stop offset="1" stop-color="white" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="spark-trail-fade" gradientUnits="userSpaceOnUse" x1="0" y1="810" x2="0" y2="930">
              <stop stop-color="white" />
              <stop offset="1" stop-color="white" stop-opacity="0" />
              <animateTransform attributeName="gradientTransform" type="translate" values="0 0;0 0;0 -760;0 -760" keyTimes="0;.82;.98;1" dur="26s" repeatCount="indefinite" />
            </linearGradient>
            <mask id="spark-trail-mask" maskUnits="userSpaceOnUse" x="200" y="180" width="270" height="650">
              <rect x="200" y="180" width="270" height="650" fill="url(#spark-trail-fade)" />
            </mask>
            <g id="rising-spark" opacity="0">
              <animate attributeName="opacity" values="0;0;.85;.85" keyTimes="0;.05;.16;1" dur="26s" repeatCount="indefinite" />
              <!-- Retain the travelled arc, then dissolve it from the horizon upward. -->
              <g mask="url(#spark-trail-mask)">
              <g fill="none" stroke="#83f3ff" stroke-linecap="round" filter="url(#spark-blur)">
                <use href="#spark-arc" stroke-width="3.6" stroke-opacity=".18" stroke-dasharray="1 1" stroke-dashoffset="1">
                  <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;.05;.8;1" calcMode="spline" keySplines="0 0 1 1;.42 0 .58 1;0 0 1 1" dur="26s" repeatCount="indefinite" />
                </use>
                <use href="#spark-arc" stroke-width="1.8" stroke-opacity=".4" stroke-dasharray="1 1" stroke-dashoffset="1">
                  <animate attributeName="stroke-dashoffset" values="1;1;0;0" keyTimes="0;.05;.8;1" calcMode="spline" keySplines="0 0 1 1;.42 0 .58 1;0 0 1 1" dur="26s" repeatCount="indefinite" />
                </use>
              </g>
              </g>
              <g>
                <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;.94;.99;1" dur="26s" repeatCount="indefinite" />
                <animateMotion keyPoints="0;0;1;1" keyTimes="0;.05;.8;1" calcMode="spline" keySplines="0 0 1 1;.42 0 .58 1;0 0 1 1" dur="26s" repeatCount="indefinite">
                  <mpath href="#spark-arc" />
                </animateMotion>
                <circle r="12" fill="url(#spark-glow)" />
                <g filter="url(#spark-flare-blur)">
                  <rect x="-24" y="-.8" width="48" height="1.6" fill="url(#spark-flare-horizontal)" />
                  <rect x="-.8" y="-32" width="1.6" height="64" fill="url(#spark-flare-vertical)" />
                </g>
                <circle r="1.5" fill="#a3faff" />
              </g>
            </g>
            <g id="twilight-clouds">
              <g>
                <image id="cloud-sheet-near" class="cloud-sheet" x="0" y="0" width="1140" height="1000" preserveAspectRatio="none" />
                <use href="#cloud-sheet-near" x="1140" />
                <animateTransform attributeName="transform" type="translate" from="-1140 0" to="0 0" dur="210s" repeatCount="indefinite" />
              </g>
              <g>
                <image id="cloud-sheet-far" class="cloud-sheet" x="0" y="0" width="1140" height="1000" preserveAspectRatio="none" />
                <use href="#cloud-sheet-far" x="1140" />
                <animateTransform attributeName="transform" type="translate" from="-1140 0" to="0 0" dur="270s" repeatCount="indefinite" />
              </g>
            </g>
          </defs>
          <use href="#twilight-clouds" />
          <use href="#rising-spark" />
          <!-- Broad volcanic slopes and a small, uneven summit, drawn from the reference. -->
          <path d={mountainPath} fill="#15233b" />
        <svg class="water" y="785" width="1000" height="215" viewBox="0 0 1000 215" preserveAspectRatio="none" focusable="false">
          <defs>
            <filter id="water-turbulence" x="-5%" y="-15%" width="110%" height="130%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency=".008 .14" numOctaves="1" seed="8" result="ripples">
                <animate attributeName="baseFrequency" values=".008 .14;.01 .175;.008 .14" dur="14s" repeatCount="indefinite" />
              </feTurbulence>
              <feDisplacementMap in="SourceGraphic" in2="ripples" scale="6" xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <linearGradient id="water-depth" x2="0" y2="1">
              <stop stop-color="#12233d" stop-opacity="0" />
              <stop offset=".12" stop-color="#12233d" stop-opacity="0" />
              <stop offset="1" stop-color="#071329" stop-opacity=".6" />
            </linearGradient>
            <filter id="water-surface" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency=".006 .21" numOctaves="1" seed="12">
                <animate attributeName="baseFrequency" values=".006 .21;.008 .2625;.006 .21" dur="12s" repeatCount="indefinite" />
              </feTurbulence>
              <feColorMatrix type="matrix" values="0 0 0 0 .65  0 0 0 0 .72  0 0 0 0 .85  0 0 0 .07 0" />
            </filter>
            <!-- Keep the shoreline exact; introduce the filtered copy only below it. -->
            <linearGradient id="ripple-fade" x1="0" y1="0" x2="0" y2="1">
              <stop stop-color="white" stop-opacity="0" />
              <stop offset=".04" stop-color="white" stop-opacity="0" />
              <stop offset=".22" stop-color="white" />
            </linearGradient>
            <mask id="ripple-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="215">
              <path d="M0 0H1000V215H0Z" fill="url(#ripple-fade)" />
            </mask>
            <g id="reflected-scene" transform="translate(0 785) scale(1 -1)">
              <image class="water-sky" x="0" y="0" width="1000" height="1000" preserveAspectRatio="none" />
              <use href="#twilight-clouds" />
              <use href="#rising-spark" />
              <path d={mountainPath} fill="#15233b" />
            </g>
          </defs>
          <use href="#reflected-scene" />
          <g mask="url(#ripple-mask)">
            <g filter="url(#water-turbulence)">
              <use href="#reflected-scene" />
            </g>
          </g>
          <path d="M0 0H1000V215H0Z" fill="url(#water-depth)" />
          <g mask="url(#ripple-mask)">
            <path d="M0 0H1000V215H0Z" filter="url(#water-surface)" />
          </g>
        </svg>
        </svg>
      </div>
      <div class="film-grain" aria-hidden="true"></div>
      <header><a href="/" aria-label="Back to home">← home</a></header>
      <footer><button type="button" aria-pressed="false">Pause motion</button></footer>
    </main>
    <script>
      import { mountAtmosphere } from '../scripts/twilight-atmosphere';
      import { createCloudTexture } from '../scripts/twilight-clouds';
      document.querySelectorAll<SVGImageElement>('.cloud-sheet').forEach((sheet, layer) => {
        sheet.setAttribute('href', createCloudTexture(layer));
      });
      const atmosphere = document.querySelector<HTMLCanvasElement>('.atmosphere');
      const waterSky = document.querySelector<SVGImageElement>('.water-sky');
      const water = document.querySelector<SVGSVGElement>('.terrain');
      if (atmosphere) mountAtmosphere(atmosphere, () => {
        waterSky?.setAttribute('href', atmosphere.toDataURL());
      });
      const button = document.querySelector<HTMLButtonElement>('button');
      const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
      function setPaused(paused: boolean) {
        document.documentElement.classList.toggle('paused', paused);
        document.documentElement.classList.add('motion-ready');
        if (paused) water?.pauseAnimations();
        else water?.unpauseAnimations();
        button?.setAttribute('aria-pressed', String(paused));
        if (button) button.textContent = paused ? 'Resume motion' : 'Pause motion';
      }
      setPaused(preference.matches);
      preference.addEventListener('change', event => setPaused(event.matches));
      button?.addEventListener('click', () => setPaused(button.getAttribute('aria-pressed') !== 'true'));
    </script>
  </body>
</html>
<style>
  :global(html), :global(body) { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #071329; }
  :global(astro-dev-toolbar) { display: none; }
  main { position: fixed; inset: 0; isolation: isolate; color: #a1aec5; font: 11px/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .landscape { position: absolute; inset: -12px; overflow: hidden; filter: brightness(.9); background: linear-gradient(#08152f, #30486a 48%, #65516a 69%, #795b66 76%, #24344e); }
  .atmosphere { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sky-haze { position: absolute; inset: 0; background: radial-gradient(ellipse at 20% 55%, #788bad08, transparent 65%); }
  .stars { position: absolute; inset: 0; }
  .stars i { position: absolute; display: block; border-radius: 50%; background: #d6e2ff; }
  .terrain { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .water { overflow: hidden; }
  :global(.paused) .film-grain { animation-play-state: paused; }
  /* Same animated grain asset and settings as the regular website. */
.film-grain {
  position: fixed;
  inset: -50%;
  width: 400%;
  height: 400vh;
  z-index: 900;
  background: transparent url('/assets/noise.png') repeat 0 0;
  animation: noise 1000ms infinite;
  pointer-events: none;
  opacity: 1;
  mix-blend-mode: soft-light;
}
@keyframes noise {
  0%, 100% { background-position: 0 0; }
  10% { background-position: -5% -10%; }
  20% { background-position: -15% 5%; }
  30% { background-position: 7% -25%; }
  40% { background-position: 20% 25%; }
  50% { background-position: -25% 10%; }
  60% { background-position: 15% 5%; }
  70% { background-position: 0 15%; }
  80% { background-position: 25% 35%; }
  90% { background-position: -10% 10%; }
}
  header, footer { position: absolute; z-index: 901; left: 32px; right: 32px; display: flex; justify-content: space-between; align-items: center; letter-spacing: .08em; }
  header { top: 28px; } footer { bottom: 28px; }
  h1 { margin: 0; font: inherit; }
  a, button { color: inherit; text-decoration: none; transition: color .2s; }
  button { border: 0; padding: 8px 0 8px 12px; background: none; font: inherit; letter-spacing: inherit; cursor: pointer; }
  a:hover, button:hover { color: #e3e7ee; }
  a:focus-visible, button:focus-visible { outline: 1px solid #f1b6c8; outline-offset: 6px; }
  @media (max-width: 600px) { header, footer { left: 22px; right: 22px; } header { top: 22px; } footer { bottom: 22px; } }
  @media (prefers-reduced-motion: reduce) { :global(html:not(.motion-ready)) .film-grain { animation-play-state: paused; } }
</style>
