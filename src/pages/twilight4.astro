<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An open ocean beneath the last light of blue hour. Release a paper lantern into an endlessly changing blue hour." />
    <title>imasepan — twilight4</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body>
    <main aria-label="Twilight 4 — an open ocean and distant mountain at blue hour">
      <div class="landscape" aria-hidden="true">
        <div class="sky"></div>
        <div class="horizon-glow"></div>
        <div class="sea"></div>
        <svg class="mountains" viewBox="0 0 1600 1000" preserveAspectRatio="none" focusable="false">
          <path class="mountain-back" d="M595 536 645 530 680 517 712 513 742 501 767 501 796 485 816 480 845 459 861 455 887 435 901 431 920 411 934 404 949 387 957 388 974 363 989 355 1004 335 1015 331 1031 311 1044 301 1053 307 1065 307 1079 326 1093 335 1109 355 1123 366 1148 392 1163 399 1187 426 1210 438 1230 455 1251 462 1276 481 1299 486 1329 500 1360 509 1393 519 1436 525 1490 534Z" />
        </svg>
        <canvas id="shore-lights"></canvas>
        <canvas id="lanterns"></canvas>
      </div>
      <button class="release-area" aria-label="Release a paper lantern into the sky" aria-description="Click or tap to release a lantern. Press P to pause or resume motion." type="button"></button>
      <div class="hour-controls" role="group" aria-label="Blue hour lighting">
        <svg class="hour-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 17h18M6 14a6 6 0 0 1 12 0M12 2v3M3.5 6l2 2M20.5 6l-2 2M1 12h3M20 12h3"/></svg>
        <input id="blue-hour" type="range" min="0" max="100" step="0.1" value="0" aria-label="Blue hour" aria-valuetext="Start of blue hour, 0 percent" />
        <svg class="hour-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M19 16.5A8.5 8.5 0 0 1 8 5a8.5 8.5 0 1 0 11 11.5Z"/></svg>
        <button id="auto-cycle" type="button" aria-label="Automatic blue hour cycle" aria-pressed="true" title="Automatic blue hour cycle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M19.5 9A8 8 0 0 0 6 5.5L3 9m0-5v5h5M4.5 15A8 8 0 0 0 18 18.5l3-3.5m0 5v-5h-5"/></svg>
        </button>
      </div>
      <span id="announcement" class="sr-only" role="status"></span>
    </main>
    <script>
      import { mountTwilight4 } from '../scripts/twilight4-scene';
      mountTwilight4();
    </script>
  </body>
</html>
<style>
  :global(html), :global(body) { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #18283f; }
  :global(astro-dev-toolbar) { display: none; }
  main { position: fixed; inset: 0; isolation: isolate; color: #d2d9e4; font: 10px/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; --sky-top: #416482; --sky-mid: #778b9d; --sky-low: #bbaeb0; --horizon: #edb397; --sea-top: #3d586e; --sea-mid: #35516b; --sea-bottom: #273d56; --mountain: #3b5067; --afterglow: .7; --glow-peak: 84%; --night: 0; }
  .landscape, .sky, .mountains, canvas, .release-area { position: absolute; inset: 0; width: 100%; height: 100%; }
  .landscape { overflow: hidden; }
  .sky { height: 55%; background: linear-gradient(180deg, var(--sky-top), var(--sky-mid) 66%, var(--sky-low)); }
  .horizon-glow { position: absolute; top: 0; left: 0; width: 100%; height: 54%; background: linear-gradient(180deg, transparent 49%, color-mix(in srgb, var(--horizon) 28%, transparent) 65%, var(--horizon) var(--glow-peak), color-mix(in srgb, var(--sky-low) 70%, transparent) 100%); opacity: var(--afterglow); }
  .sea { position: absolute; inset: 53.4% 0 0; background: linear-gradient(var(--sea-top), var(--sea-mid) 58%, var(--sea-bottom)); }
  .mountain-back { fill: color-mix(in srgb, var(--mountain) 55%, #071321); }
  .release-area { border: 0; background: none; cursor: crosshair; touch-action: manipulation; }
  .release-area:focus-visible { outline: 1px solid #d9c1a0; outline-offset: -9px; }
  .hour-controls { position: absolute; left: 50%; bottom: max(25px, env(safe-area-inset-bottom)); transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 3px 11px 3px 17px; border: 1px solid #d0dbea18; border-radius: 28px; background: #09142555; backdrop-filter: blur(12px); color: #dce1e8; }
  .hour-icon { width: 16px; height: 16px; opacity: .65; flex: none; }
  #blue-hour { appearance: none; -webkit-appearance: none; width: clamp(115px, 18vw, 220px); height: 44px; margin: 0; background: transparent; cursor: pointer; }
  #blue-hour::-webkit-slider-runnable-track { height: 3px; border-radius: 3px; background: linear-gradient(90deg, #d1ab9f, #a8899e 27%, #6a6486 50%, #344b6c 75%, #142540); }
  #blue-hour::-moz-range-track { height: 3px; border-radius: 3px; background: linear-gradient(90deg, #d1ab9f, #a8899e 27%, #6a6486 50%, #344b6c 75%, #142540); }
  #blue-hour::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 10px; height: 10px; margin-top: -3.5px; border-radius: 50%; border: 1px solid #e6e5e2; background: #d2d6df; box-shadow: 0 0 10px #dce5f03b; }
  #blue-hour::-moz-range-thumb { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #e6e5e2; background: #d2d6df; box-shadow: 0 0 10px #dce5f03b; }
  #auto-cycle { display: grid; place-items: center; width: 36px; height: 44px; padding: 8px; border: 0; background: none; color: inherit; cursor: pointer; opacity: .4; }
  #auto-cycle svg { width: 17px; height: 17px; }
  #auto-cycle[aria-pressed="true"] { opacity: .95; }
  #auto-cycle:hover { opacity: 1; }
  #blue-hour:focus-visible, #auto-cycle:focus-visible { outline: 1px solid #e2d5c1; outline-offset: 3px; border-radius: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 600px) { .mountains { width: 155%; left: -40%; } }
</style>
