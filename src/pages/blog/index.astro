---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { postUrl, formatDate, excerpt } from '../../lib/posts';
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<SiteLayout title="writing" description="Writing by imasepan.">
  <div class="journal-page">
    <section class="page-intro">
      <div class="blog-intro-copy"><h1 data-reveal-heading>A piece of my mind.</h1></div>
    </section>
    <section class="post-list" aria-label="Blog posts">
      {posts.map(post => (
        <a class:list={['post-card', { 'has-image': post.data.image }]} href={postUrl(post)}>
          {post.data.image && <img class="post-card-image" src={post.data.image} alt="" loading="lazy" />}
          <span class="post-card-content">
            <span class="post-meta">{formatDate(post.data.date)}</span>
            <span class="post-card-title">{post.data.title}</span>
            <span class="post-card-excerpt">{excerpt(post)}</span>
            <span class="text-link">Read post →</span>
          </span>
        </a>
      ))}
    </section>
  </div>
</SiteLayout>
