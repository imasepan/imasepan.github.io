---
interface Props { title?: string; description?: string; }
const { title = "home", description = "charlie's website where he writes about stuff people don't care about" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>imasepan — {title}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=DM+Sans:wght@400;500;600;700&amp;family=Special+Elite&amp;display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css?v=20260926-25" />
  <link rel="stylesheet" href="/overlay.css?v=20261002-4" />
  <link rel="stylesheet" href="/frutiger.css?v=20261004-1" />
</head>
<body class="overlay-site">
  <audio id="rain-audio" src="/assets/dragon-studio-heavy-rain-outside-the-window-515266.mp3" loop preload="none" hidden></audio>
  <div class="home-screen">
    <header class="home-header">
      <button class="rain-toggle" type="button" data-appearance-mode="rain" aria-pressed="false">Rain</button>
      <button class="theme-toggle" type="button" aria-label="Switch color theme">Theme</button>
      <button class="appearance-button" type="button" data-appearance-mode="frutiger" aria-pressed="false">Clouds</button>
    </header>
    <main class="home-menu" aria-label="Home">

      <nav class="home-links" aria-label="Main navigation">
        <a href="/about.html">About</a>
        <a href="/work.html">Work</a>
        <a href="/blog/">Blog</a>
        <div class="guestbook-menu-item">
          <a href="/guestbook.html">Guestbook</a>
          <aside class="music-dock" aria-label="Featured Spotify playlist">
            <iframe class="spotify-player" title="Spotify playlist" src="https://open.spotify.com/embed/playlist/3U7y10CsdmnU7IfRpZRooU?utm_source=generator" width="320" height="80" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
          </aside>
        </div>
      </nav>
    </main>

    <nav class="home-webring" aria-label="Purdue Hackers webring">
      <a href="https://ring.purduehackers.com/previous"><-</a>
      <a class="webring-brand" href="https://ring.purduehackers.com/" aria-label="Purdue Hackers webring">
        <svg width="811" height="1058" viewBox="0 0 811 1058" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M201.218 114.38L405.712 233.613L603.78 117.946L810.102 238.452L810.102 700.846L618.771 811.773L618.588 569.426L402.193 696.075V937.957L204.825 1056.98L2.4834 935.779L2.48347 693.041L201.47 578.313L201.218 114.38Z" fill="var(--ink)"/>
          <path d="M406.02 233.788L401.722 697.171L201.358 577.956V114.571L406.02 233.788Z" fill="var(--line)"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M405.717 233.614L201.213 114.379L402.523 0L603.78 117.947L405.717 233.614Z" fill="var(--line)"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M204.504 811.309L0 692.073L201.31 577.694L402.567 695.641L204.504 811.309Z" fill="var(--line)"/>
          <path d="M603.784 348.922V117.961L809.894 238.438L603.784 348.922Z" fill="var(--line)"/>
          <path d="M204.872 1057.66V810.816L2.50391 692.917V936.988L204.872 1057.66Z" fill="var(--line)"/>
        </svg>
        <span>Purdue Hackers<br />webring</span>
      </a>
      <a href="https://ring.purduehackers.com/next">-></a>
    </nav>

  </div>
  <div class="overlay-veil" aria-hidden="true"></div>
  <dialog class="page-overlay" aria-labelledby="overlay-label">
    <header class="overlay-bar"><span id="overlay-label">{title}</span><a class="overlay-close" href="/" autofocus>Close <span aria-hidden="true">×</span></a></header>
    <div class="overlay-scroll" tabindex="0"><div class="overlay-content"><slot /></div></div>
  </dialog>
  <noscript><style is:inline>.page-overlay:not([open]){display:block;position:fixed}.home-screen{display:none}</style><p>Please enable JavaScript to use the overlay navigation. <a href="/blog/">Blog</a> · <a href="/about.html">About</a> · <a href="/guestbook.html">Guestbook</a> · <a href="/work.html">Work</a></p></noscript>
  <script is:inline src="/script.js?v=20261007-1"></script>
  <script is:inline src="/overlay.js?v=20261002-1"></script>
  <script is:inline type="module" src="/frutiger.js?v=20261001-1"></script>
</body>
</html>
